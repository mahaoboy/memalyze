# /etc/memalyze/memalyze.env — root:memalyze, 0640
# 生成强 token：openssl rand -hex 24
MEMALYZE_HTTP_ADDR=127.0.0.1:8080
MEMALYZE_HTTP_TOKEN=replace-with-a-long-random-token
MEMALYZE_TENANT=default
MEMALYZE_ACTOR=systemd
MEMALYZE_REDACT_MODE=enforce
MEMALYZE_AUDIT=on
MEMALYZE_OLLAMA_URL=http://127.0.0.1:11434
MEMALYZE_EMBED_MODEL=qwen3-embedding:0.6b
MEMALYZE_QUERY_TIMEOUT=3s
MEMALYZE_KEEP_ALIVE=30m
