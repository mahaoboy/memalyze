    "cordis.patch.yml",
    "SKILL.md",
    "README.md",
    "LICENSE",
    "bin/*.gz"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "agent-memory",
    "mcp",
    "sqlite",
    "self-hosted"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "homepage": "https://github.com/mahaoboy/memalyze",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mahaoboy/memalyze.git",
    "directory": "integrations/dsh"
  },
  "bugs": {
    "url": "https://github.com/mahaoboy/memalyze/issues"
  },
