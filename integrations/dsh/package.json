{
  "name": "dsh-plugin-memalyze",
  "version": "0.2.0",
  "description": "Self-hosted agent memory for DeepSeek Harness: one Go binary, SQLite, redaction before write, audited reads, four MCP tools.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
